<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/ceiling_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="50dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_back_to_dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="25dp"
        app:backgroundTint="#333333"
        app:fabSize="mini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ceiling_guideline"
        app:srcCompat="@android:drawable/ic_menu_revert"
        app:tint="#00E5FF" />

    <TextView
        android:id="@+id/tv_journal_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="JOURNAL NAME"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/fab_back_to_dashboard"
        app:layout_constraintEnd_toStartOf="@id/btn_view_toggle"
        app:layout_constraintStart_toEndOf="@id/fab_back_to_dashboard"
        app:layout_constraintTop_toTopOf="@id/fab_back_to_dashboard" />

    <ImageButton
        android:id="@+id/btn_view_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/tv_journal_title"
        app:layout_constraintEnd_toStartOf="@id/btn_force_sync"
        app:layout_constraintTop_toTopOf="@id/tv_journal_title"
        app:srcCompat="@android:drawable/ic_menu_gallery"
        app:tint="#00E5FF" />

    <ImageButton
        android:id="@+id/btn_force_sync"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/tv_journal_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_journal_title"
        app:srcCompat="@android:drawable/stat_notify_sync"
        app:tint="#00E5FF" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:padding="2dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fab_back_to_dashboard"
        tools:listitem="@layout/item_calendar_day" />

</androidx.constraintlayout.widget.ConstraintLayout>